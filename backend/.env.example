# DeepSeek 官方 API Key（仅余额查询）
DEEPSEEK_API_KEY=

# 可选:覆盖 API Base（默认 https://api.deepseek.com）
# DEEPSEEK_API_BASE=https://api.deepseek.com

# CodeBuddy 本地 CLI HTTP API（默认 http://127.0.0.1:8080）
# CODEBUDDY_API_BASE=http://127.0.0.1:8080
# 若 CLI --serve 开启了密码网关:
# CODEBUDDY_API_PASSWORD=

# Cursor 个人用量（浏览器 Cookie: WorkosCursorSessionToken）
# 登录 cursor.com → DevTools → Application → Cookies → 复制该值到 backend/.env
CURSOR_SESSION_TOKEN=
# 可选:覆盖 API Base（默认 https://cursor.com；勿用 www，易 308 丢 Cookie）
# CURSOR_API_BASE=https://cursor.com
